# Vantage meetings backend — copy to ".env" and fill in. NEVER commit the real .env.
# Run the backend with:  node --env-file=.env server/index.js   (Node 20+)

# --- Zoom (marketplace.zoom.us → Develop → Build App → "General App" / OAuth) ---
# Add redirect URL:  http://localhost:8787/api/zoom/callback
# Add scope:         meeting:write  (create meetings)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Google Meet (console.cloud.google.com → enable "Google Calendar API") ---
# OAuth client type: Web application
# Authorized redirect URI:  http://localhost:8787/api/google/callback
# For "Continue with Google" sign-in, add a SECOND redirect URI to the SAME app:
#   http://localhost:8787/api/auth/oauth/google/callback   (scopes: openid email profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Yahoo sign-in (developer.yahoo.com → Create an App; OpenID Connect) ---
# Optional: enables the "Continue with Yahoo" button. Set the redirect/callback domain to:
#   http://localhost:8787/api/auth/oauth/yahoo/callback   (permissions: OpenID Connect — email, profile)
# (Proton is intentionally omitted — it offers no third-party "Sign in with Proton".)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# --- Stripe (dashboard.stripe.com → Developers → API keys; use TEST keys) ---
# Optional: without STRIPE_SECRET_KEY, plans unlock as a labelled simulation.
# Create THREE recurring Prices and paste their price_… IDs. There is no free
# tier — every plan is billed monthly after a 7-day trial the server adds to the
# Checkout session, so leaving STRIPE_PRICE_EXPLORER blank makes Explorer the one
# plan nobody can subscribe to.
#   Explorer $12/mo · Pro Desk $25/mo · Trading Floor $39/mo
STRIPE_SECRET_KEY=
STRIPE_PRICE_EXPLORER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_DESK=
STRIPE_WEBHOOK_SECRET=

# --- Hosted AI (Vertex AI / Gemini) ---
# Enable Vertex AI in a Google Cloud project, then create a service account with Vertex AI User.
# These values stay on the server. For a hosted deployment, use its secret manager.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_EMAIL=
# Put PEM line breaks in this value as literal \n characters.
GCP_SERVICE_ACCOUNT_PRIVATE_KEY=
VERTEX_GEMINI_MODEL=gemini-3.6-flash

# --- Scheduled market-brief agent ---
# A server-owned Finnhub key supplies quote snapshots for opted-in watchlists.
# Configure Cloud Scheduler (or equivalent) to POST daily to /api/agent/run with
# the HTTP header: x-vantage-cron-secret: <this value>.
FINNHUB_API_KEY=
AGENT_CRON_SECRET=

# --- DataHub (data catalog context for the AI desk agent) ---
# GMS base URL (the metadata service, not the frontend). Local quickstart default shown.
DATAHUB_GMS_URL=http://localhost:8080
# Personal Access Token — server-only, never sent to the browser. Optional: the local
# quickstart runs with metadata-service auth disabled and answers unauthenticated queries.
DATAHUB_TOKEN=

# --- server / app origins (defaults are fine for local dev) ---
PORT=8787
PUBLIC_ORIGIN=http://localhost:8787
APP_ORIGIN=http://127.0.0.1:5173

# --- AI desk (openrouter.ai → Keys) ---
# REQUIRED for the desk to answer. This is the whole point of the backend proxy:
# the browser never receives this value, it POSTs to /api/ai/chat instead.
# Users may still paste their own key in Settings → AI to bill themselves; that
# path talks to OpenRouter directly and ignores this one.
OPENROUTER_API_KEY=
# Optional — the default model when the client does not name one.
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- YouTube Data API v3 (console.cloud.google.com → enable "YouTube Data API v3") ---
# Optional: enables real, embeddable video results. Held server-side; the browser
# calls /api/youtube/search instead and never receives the key.
# RESTRICT THIS KEY in the Cloud console (API restriction: YouTube Data API v3,
# plus an IP restriction for your server) — an unrestricted Google key is spendable.
YOUTUBE_API_KEY=

# --- anonymous spend guards (per IP, per hour) ---
# The desk answers without an account, so these cap what an anonymous visitor
# can spend of yours. Signed-in users use their plan's daily quota instead.
ANON_AI_PER_HOUR=6
ANON_YT_PER_HOUR=20
# Set to 1 ONLY when a reverse proxy you control sets X-Forwarded-For. Otherwise
# the header is caller-controlled and the per-IP limit becomes spoofable.
TRUST_PROXY=0

# --- live quotes (finnhub.io → free tier) ---
# Held server-side; the browser calls /api/quote and never receives the key.
# NOTE: this is the canonical name. The server also still accepts the older
# FINNHUB_KEY so existing .env files keep working.
FINNHUB_API_KEY=
# Per-IP hourly cap for anonymous quote calls. Generous by default: one
# watchlist refresh is a single batched request, not one per symbol.
ANON_QUOTE_PER_HOUR=1000

# --- streaming catalog (themoviedb.org → Settings → API) ---
TMDB_API_KEY=

# --- Gemini (aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- studio voice (elevenlabs.io → Settings → API Keys) ---
# Billed per character. /api/tts requires a signed-in Trading Floor account and
# meters each one in characters per day — it used to answer anyone at all.
# Use the SECRET, which starts "sk_" — not the 64-character hex key ID shown
# next to it in the dashboard. The API rejects the ID with a 401.
ELEVENLABS_API_KEY=
ANON_TTS_PER_HOUR=30
TTS_DAILY_CHARS=40000

# --- ambient music ---
# The desk's playlist, served to every client from /api/status. Not a secret —
# a Spotify share link is public — but it is the operator's choice, so nobody
# has to paste one into settings. Spotify → any playlist/album/track → Share →
# Copy link. Leave blank to fall back to the built-in Lofi Beats playlist.
SPOTIFY_PLAYLIST=
